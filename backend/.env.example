PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://pace_user:pace_password@localhost:5432/pace_db
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
RESET_SECRET=change-this-too

# File storage (leave empty for local disk, set for Supabase Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=pace-uploads

# Fallback storage (used when Supabase vars are not set)
UPLOAD_DIR=./uploads
