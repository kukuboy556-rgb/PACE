# Production environment variables (set these in Render dashboard)
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://pace_user:****@your-render-db.internal:5432/pace_db
JWT_SECRET=generate-with-node-crypto-randomBytes
JWT_EXPIRES_IN=7d
UPLOAD_DIR=/tmp/uploads
FRONTEND_URL=https://your-frontend.onrender.com
RESET_SECRET=another-random-string
